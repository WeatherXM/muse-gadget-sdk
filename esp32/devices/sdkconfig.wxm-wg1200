#
# WeatherXM WG1200 (Seeed SenseCAP Indicator WXM M2):
#   - ESP32-S3-WROOM-1 (N16R8: 16 MB QSPI flash, 8 MB octal PSRAM)
#   - 4.0" 480x480 ST7701S RGB565 LCD + FT6336U capacitive touch (0x48 GX / 0x38 DX)
#   - PCA9535 I2C0 (SDA=39, SCL=40) IO expander (0x20 / 0x39)
#   - Bosch BMP390 indoor barometer/thermometer (0x77, power on PCA9535 IO1_2)
#   - Semtech SX1262 LoRa radio (SPI3: SCLK=41, MOSI=48, MISO=47; WS1001/WS1300 RX)
#   - Production WG1200 Dual-Boot: preserves WeatherXM factory (0x20000), ota_0 (0x420000),
#     esp_secure_cert (0xD000), nvs (0xF000), nvs_key (0xC20000), spiffs (0xC21000);
#     installs Muse into ota_1 (0x820000) and isolates NVS into muse_nvs (0xF21000).
#
# Load after sdkconfig.defaults:
#   SDKCONFIG_DEFAULTS="sdkconfig.defaults;devices/sdkconfig.wxm-wg1200" idf.py build

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Full Muse LVGL UI + WG1200 board driver
CONFIG_HOMEHUB_LED_BACKEND_MUSE=y
CONFIG_MUSE_BOARD_WXM_WG1200=y
CONFIG_HOMEHUB_BLE_NAME_PREFIX="MuseGadget"
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-WG1200"
# Set your SDK token in build-muse-wxm-wg1200/sdkconfig (ignored by Git), via
# menuconfig (ESP32 Device SDK -> Muse Gadgets SDK token), or over USB serial:
#   printf '>sdk_token=mgst_...\n' > /dev/cu.usbserial-xxxx
CONFIG_HOMEHUB_BUTTON_GPIO=38
CONFIG_HOMEHUB_OTA_ENABLED=y
CONFIG_HOMEHUB_DISPLAY_COMMANDS=y

# Production WG1200 Dual-Boot Partition Table (at 0xC000 matching WG1200 bootloader)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_wg1200_dualboot.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xc000
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Console on CH340 USB-UART0 bridge
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n

# Production WG1200 Secure Boot V2 RSA-3072 App Signing
# Set CONFIG_SECURE_BOOT_SIGNING_KEY in build-muse-wxm-wg1200/sdkconfig or via
# tools/wg1200_dualboot.sh (WXM_SIGNING_KEY=/path/to/secure_boot_signing_key.pem)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 8 MB Octal PSRAM + XIP + 64 KB D-cache (64B line) for tear-free RGB565 DMA
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=n

# LVGL 9 avatar and settings UI
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_SNAPSHOT=y

# NimBLE + Wi-Fi + TLS memory tuning for full UI + RGB LCD
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
