{
  "name": "muse-flasher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/update-manifest.mjs && astro build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check && tsc --noEmit",
    "manifest:update": "node scripts/update-manifest.mjs"
  },
  "dependencies": {
    "astro": "^5.5.0",
    "esptool-js": "0.7.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^6.0.2",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^22.13.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.4.0"
  }
}
