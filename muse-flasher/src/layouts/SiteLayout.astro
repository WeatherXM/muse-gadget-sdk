---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Muse × WeatherXM WG1200 Dual-Boot Flasher & BLE Provisioner',
  description = 'Switch your WeatherXM WG1200 between Official WeatherXM firmware (ota_0) and signed Muse Gadget OS (ota_1), inject SDK tokens, and provision Home Link & Companion BLE.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="grid-backdrop min-h-screen flex flex-col text-ink antialiased">
    <slot />
  </body>
</html>
