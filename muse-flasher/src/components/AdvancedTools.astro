<dialog id="advanced-tools-dialog" closedby="any" aria-labelledby="advanced-tools-title">
  <div class="p-6">
    <div class="flex items-start justify-between gap-4 pb-4 border-b border-line">
      <div>
        <div class="font-mono text-[11px] uppercase tracking-wider text-ink-muted">
          WG1200 Engineering &amp; Recovery
        </div>
        <h2 id="advanced-tools-title" class="mt-1 font-display text-lg font-bold text-ink">
          Advanced Flash &amp; Recovery Tools
        </h2>
      </div>
      <form method="dialog">
        <button
          type="submit"
          class="rounded-lg border border-line bg-canvas-subtle p-1.5 text-ink-muted hover:text-ink"
          aria-label="Close advanced tools dialog"
        >
          ✕
        </button>
      </form>
    </div>

    <div class="mt-4 space-y-4">
      <!-- Tool 1: Export Diagnostic Flash Backup ZIP -->
      <div class="rounded-xl border border-line bg-canvas-subtle p-4">
        <div class="font-display text-sm font-semibold text-ink">
          Export Diagnostic Metadata Backup (.zip)
        </div>
        <p class="mt-1 text-xs text-ink-secondary">
          Reads and archives <code class="font-mono">partition-table-0xC000.bin</code>, <code class="font-mono">otadata-0x13000.bin</code>, and the 512-byte app headers of <code class="font-mono">factory</code>, <code class="font-mono">ota_0</code>, and <code class="font-mono">ota_1</code>.
        </p>
        <button
          type="button"
          id="export-backup-zip-btn"
          disabled
          class="mt-3 rounded-xl border border-line-strong bg-surface hover:bg-surface-hover px-4 py-2 text-xs font-semibold text-ink transition-colors disabled:opacity-40"
        >
          Download Diagnostic Backup ZIP
        </button>
      </div>

      <!-- Tool 2: Boot Factory Recovery Slot (0x020000) -->
      <div class="rounded-xl border border-state-warning-border bg-state-warning-bg/40 p-4">
        <div class="font-display text-sm font-semibold text-state-warning">
          Boot Immutable Factory WeatherXM Slot (`0x020000`)
        </div>
        <p class="mt-1 text-xs text-ink-secondary">
          Resets <code class="font-mono">otadata (0x013000)</code> to <code class="font-mono">0xFF</code> so the ESP32-S3 ROM bootloader falls back to the immutable factory WeatherXM image at <code class="font-mono">0x020000</code>. Both <code class="font-mono">ota_0</code> and <code class="font-mono">ota_1</code> remain intact.
        </p>
        <button
          type="button"
          id="reset-factory-slot-btn"
          disabled
          class="mt-3 rounded-xl border border-state-warning-border bg-state-warning/20 hover:bg-state-warning/30 px-4 py-2 text-xs font-semibold text-state-warning transition-colors disabled:opacity-40"
        >
          Activate Factory Recovery Slot (`0x020000`)
        </button>
      </div>
    </div>

    <div class="mt-6 flex justify-end">
      <form method="dialog">
        <button
          type="submit"
          class="rounded-xl border border-line bg-surface px-4 py-2 text-xs font-medium text-ink-secondary hover:text-ink"
        >
          Close
        </button>
      </form>
    </div>
  </div>
</dialog>
