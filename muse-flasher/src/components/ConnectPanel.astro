<section class="instrument-panel overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-12">
    <!-- Left Column: Instructions & Connect CTA -->
    <div class="lg:col-span-8 p-6 sm:p-7 flex flex-col justify-between">
      <div>
        <div class="inline-flex items-center gap-2 rounded-pill border border-line bg-canvas-subtle px-3 py-1 text-xs font-mono text-ink-secondary mb-4">
          <span class="h-2 w-2 rounded-full bg-muse animate-pulse"></span>
          WeatherXM WG1200 Gateway · ESP32-S3 · 16 MB Flash · RSA-3072 Secure Boot V2
        </div>

        <h1 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Dual-Boot Firmware Switcher &amp; Device Provisioner
        </h1>

        <p class="mt-2.5 text-sm text-ink-secondary leading-relaxed max-w-2xl">
          Install signed <strong class="text-muse font-medium">Muse Gadget OS</strong> into <code class="font-mono text-xs bg-canvas-subtle px-1.5 py-0.5 rounded border border-line">ota_1 (0x820000)</code> while keeping your official <strong class="text-wxm font-medium">WeatherXM Firmware</strong> intact in <code class="font-mono text-xs bg-canvas-subtle px-1.5 py-0.5 rounded border border-line">ota_0 (0x420000)</code> and <code class="font-mono text-xs bg-canvas-subtle px-1.5 py-0.5 rounded border border-line">factory (0x020000)</code>. Once both slots are populated, switching between Muse and WeatherXM takes just <strong>~2 seconds</strong>.
        </p>

        <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="rounded-xl border border-line bg-canvas-subtle/70 p-3">
            <div class="font-mono text-[11px] uppercase tracking-wider text-wxm font-semibold">
              Slot A · ota_0 (0x420000)
            </div>
            <div class="mt-1 font-medium text-ink">WeatherXM Official</div>
            <p class="mt-0.5 text-ink-muted">
              Preserves station identity, LoRa keys, and WeatherXM NVS (`0x00F000`).
            </p>
          </div>

          <div class="rounded-xl border border-line bg-canvas-subtle/70 p-3">
            <div class="font-mono text-[11px] uppercase tracking-wider text-muse font-semibold">
              Slot B · ota_1 (0x820000)
            </div>
            <div class="mt-1 font-medium text-ink">Muse Gadget OS</div>
            <p class="mt-0.5 text-ink-muted">
              Isolated `muse_nvs` (`0xF21000`) for SDK token, Home Link BLE &amp; Wi-Fi.
            </p>
          </div>

          <div class="rounded-xl border border-line bg-canvas-subtle/70 p-3">
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-secondary font-semibold">
              Post-Flash Setup
            </div>
            <div class="mt-1 font-medium text-ink">USB Token + BLE Pairing</div>
            <p class="mt-0.5 text-ink-muted">
              Auto-injects `mgst_...` token &amp; pairs `provision_v2` over Web Bluetooth.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-5 border-t border-line flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
          <button
            type="button"
            id="connect-usb-btn"
            class="inline-flex items-center gap-2.5 rounded-xl bg-wxm hover:bg-wxm-hover px-5 py-2.5 text-sm font-semibold text-white shadow-glow-wxm transition-all focus:outline-none focus:ring-2 focus:ring-wxm/50 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span id="connect-usb-btn-label">Connect WG1200 via USB Serial</span>
          </button>

          <button
            type="button"
            id="disconnect-usb-btn"
            class="hidden rounded-xl border border-line bg-surface-raised hover:bg-surface-hover px-4 py-2.5 text-xs font-medium text-ink-secondary hover:text-ink transition-colors"
          >
            Disconnect USB
          </button>

          <button
            type="button"
            id="jump-to-ble-setup-btn"
            class="inline-flex items-center gap-2 rounded-xl border border-muse-border bg-muse-subtle hover:bg-muse/20 px-4 py-2.5 text-xs font-semibold text-muse transition-colors"
          >
            <span>Already Flashed? Open Token &amp; BLE Setup →</span>
          </button>
        </div>

        <span id="usb-connection-badge" class="font-mono text-xs text-ink-muted">
          Status: Disconnected
        </span>
      </div>

      <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-xs text-ink-muted">
        <p>
          The port picker lists the WG1200's fast native port, <strong class="text-ink">USB JTAG/serial debug unit</strong>
          (<code class="font-mono">303a:1001</code>, ~20 s to flash). Its CH340 <strong class="text-ink">USB Serial</strong>
          port (<code class="font-mono">1a86:7523</code>) also works, but takes several minutes.
        </p>
        <label for="usb-show-all-ports" class="inline-flex cursor-pointer items-center gap-2 text-ink-secondary">
          <input type="checkbox" id="usb-show-all-ports" class="accent-[var(--accent-wxm)]" />
          Show all serial ports (incl. CH340)
        </label>
      </div>
    </div>

    <!-- Right Column: WG1200 Hardware Illustration -->
    <div class="lg:col-span-4 border-t lg:border-t-0 lg:border-l border-line bg-canvas-subtle/60 p-6 flex flex-col items-center justify-center text-center">
      <div class="relative w-44 h-44 flex items-center justify-center">
        <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-wxm/15 to-muse/15 blur-2xl"></div>
        <img
          src="/wg1200-gateway.webp"
          alt="WeatherXM WG1200 Gateway"
          class="relative max-h-40 w-auto object-contain drop-shadow-2xl"
        />
      </div>
      <div class="mt-3">
        <div class="font-display text-xs font-semibold uppercase tracking-wider text-ink-secondary">
          USB-C Port Connection
        </div>
        <p class="mt-1 text-xs text-ink-muted max-w-xs">
          Plug your WG1200 into your computer via USB-C. No boot button press is required.
        </p>
      </div>
    </div>
  </div>
</section>
