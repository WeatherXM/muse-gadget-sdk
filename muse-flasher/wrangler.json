{
  "name": "muse-flasher",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-17",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "muse.weatherxm.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MUSE_API_URL": "https://api.muse.ai",
    "MUSE_API_VERSION": "1.0.0"
  },
  "observability": {
    "enabled": true
  }
}
